VITE_API_URL=http://localhost:3000/api/v1
VITE_AUTH0_DOMAIN=your-auth0-domain
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_CALLBACK_URL=http://localhost:5173/callback

# PostHog product analytics (frontend-only, public key)
# Get yours at https://eu.posthog.com → Settings → Project API Key (phc_…)
# If VITE_POSTHOG_KEY is empty, analytics is a no-op (dev/test runs without it).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
