# Test environment configuration
NODE_ENV=test
PORT=3001
API_PREFIX=api/v1
SESSION_SECRET=test-session-secret-min-32-characters-long-x

# Auth0 (not validated in test environment)
AUTH0_DOMAIN=test.auth0.com
AUTH0_CLIENT_ID=test-client-id
AUTH0_CLIENT_SECRET=test-client-secret
AUTH0_CALLBACK_URL=http://localhost:3001/api/v1/auth/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads-test

# OCR
OCR_DRIVER=mock

# AI
CLAUDE_API_KEY=test-key

# Queue
QUEUE_DRIVER=memory

# Logging
LOG_LEVEL=error

# CORS
CORS_ORIGIN=http://localhost:5173
