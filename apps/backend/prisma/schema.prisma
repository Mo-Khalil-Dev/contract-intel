generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  auth0SubjectId String     @unique
  displayName   String
  role          UserRole    @default(REVIEWER)
  tenantId      String
  lastLoginAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions      Session[]
  annotations   Annotation[]

  @@index([tenantId])
  @@index([auth0SubjectId])
}

model Session {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedToken  String
  encryptedRefreshToken String
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
}

model Tenant {
  id            String      @id @default(cuid())
  name          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  documents     Document[]
  engagements   Engagement[]
  auditEvents   AuditEvent[]
}

model Document {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName        String
  mimeType        String
  fileSizeBytes   Int
  fileChecksum    String      @unique
  storageKey      String
  status          DocumentStatus @default(UPLOADED)
  uploadedAt      DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  clauses         Clause[]
  auditEvents     AuditEvent[]

  @@index([tenantId])
  @@index([status])
}

model Clause {
  id                  String      @id @default(cuid())
  documentId          String
  document            Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type                ClauseType
  text                String      @db.Text
  startOffset         Int
  endOffset           Int
  pageNumber          Int
  confidence          Float
  riskScore           Int
  riskLevel           RiskLevel
  reviewStatus        ClauseReviewStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  riskFlags           RiskFlag[]
  annotations         Annotation[]

  @@index([documentId])
  @@index([type])
  @@index([riskLevel])
}

model RiskFlag {
  id          String      @id @default(cuid())
  clauseId    String
  clause      Clause      @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  category    String
  severity    RiskLevel
  description String      @db.Text
  suggestion  String      @db.Text
  createdAt   DateTime    @default(now())

  @@index([clauseId])
}

model Engagement {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            EngagementType
  status          EngagementStatus @default(DRAFT)
  title           String
  description     String?     @db.Text
  deadline        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reviewers       ReviewerAssignment[]
  annotations     Annotation[]
  auditEvents     AuditEvent[]

  @@index([tenantId])
  @@index([status])
}

model ReviewerAssignment {
  id              String      @id @default(cuid())
  engagementId    String
  engagement      Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId          String
  role            ReviewerRole
  assignedAt      DateTime    @default(now())

  @@index([engagementId])
  @@unique([engagementId, userId])
}

model Annotation {
  id              String      @id @default(cuid())
  clauseId        String
  clause          Clause      @relation(fields: [clauseId], references: [id], onDelete: Cascade)
  engagementId    String
  engagement      Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  type            AnnotationType
  text            String      @db.Text
  status          AnnotationStatus @default(OPEN)
  resolvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  comments        Comment[]

  @@index([clauseId])
  @@index([engagementId])
  @@index([authorId])
}

model Comment {
  id              String      @id @default(cuid())
  annotationId    String
  annotation      Annotation  @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  authorId        String
  text            String      @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([annotationId])
}

model AuditEvent {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId         String
  action          AuditAction
  resourceType    String
  resourceId      String?
  documentId      String?
  document        Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  engagementId    String?
  engagement      Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  checksum        String
  sequenceNumber  Int
  ipAddress       String?
  userAgent       String?
  metadata        String?     @db.Text
  createdAt       DateTime    @default(now())

  @@index([tenantId])
  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  ENGAGEMENT_MANAGER
  LEAD_REVIEWER
  REVIEWER
}

enum DocumentStatus {
  UPLOADED
  QUEUED_FOR_OCR
  OCR_PROCESSING
  OCR_COMPLETE
  ANALYZING
  READY
  FAILED
  DELETED
}

enum ClauseType {
  INDEMNIFICATION
  LIMITATION_OF_LIABILITY
  TERMINATION
  GOVERNING_LAW
  DISPUTE_RESOLUTION
  INTELLECTUAL_PROPERTY
  CONFIDENTIALITY
  PAYMENT_TERMS
  REPRESENTATIONS_WARRANTIES
  FORCE_MAJEURE
  ASSIGNMENT
  CHANGE_OF_CONTROL
  NON_COMPETE
  DATA_PROTECTION
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ClauseReviewStatus {
  PENDING
  IN_REVIEW
  REVIEWED
  APPROVED
  ESCALATED
}

enum EngagementType {
  MA_DUE_DILIGENCE
  VENDOR_CONTRACT
  EMPLOYMENT
  REAL_ESTATE
  FINANCING
}

enum EngagementStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ReviewerRole {
  REVIEWER
  LEAD_REVIEWER
}

enum AnnotationType {
  COMMENT
  SUGGESTION
  ISSUE
  APPROVAL
}

enum AnnotationStatus {
  OPEN
  RESOLVED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  DOCUMENT_ACCESSED
  CLAUSES_EXTRACTED
  RISK_SCORED
  ANNOTATION_ADDED
  CLAUSE_REVIEWED
  ENGAGEMENT_CREATED
  ENGAGEMENT_CLOSED
  REPORT_EXPORTED
  USER_PERMISSION_CHANGED
}
