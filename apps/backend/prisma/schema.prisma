// Prisma schema for Contract Analysis Platform.
//
// Per the Phase 1 Task 1.4 decision, persistence is introduced per-feature.
// This schema currently holds only Auth models (Phase 3). Future feature
// modules append their own models to this file.
//
// Local dev runs Postgres via docker-compose at the repo root so dev
// mirrors production. Railway provides a managed Postgres in prod; the
// plugin auto-populates DATABASE_URL on the backend service.

generator client {
  provider        = "prisma-client-js"
  // Phase 8: required to declare the `vector` extension. Prisma still
  // can't natively type `vector(N)` columns — we use `Unsupported(...)`
  // and write/read via `$queryRaw` with explicit ::vector casts.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Auth domain (Phase 3)
// -----------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  auth0SubjectId String    @unique
  displayName    String
  role           String    @default("REVIEWER") // see UserRole VO in domain layer
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions    Session[]
  chatThreads ChatThread[]

  @@index([email])
  @@index([auth0SubjectId])
}

model Session {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedAccessToken  String
  encryptedRefreshToken String
  encryptionSalt        String // PBKDF2 salt (per-session)
  keyName               String // rotating key identifier
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Documents domain (Phase 5)
// -----------------------------------------------------------------------------

model Document {
  id            String  @id // UUID, supplied by the application (DocumentId VO)
  name          String // Original filename — never used as storage key
  type          String // DocumentType enum (PDF in v1)
  sizeBytes     Int // Validated ≤50 MB at the VO layer
  status        String // pending | uploading | complete | failed
  storageKey    String  @unique // Opaque '{documentId}.{ext}' — addresses the blob
  uploadedBy    String // UserId UUID (the requester)
  orgId         String // v1: orgId == uploadedBy. Will become a real Org FK later.
  failureReason String?

  // Phase 7 — OCR pipeline state. Distinct from `status` (upload lifecycle).
  // See ProcessingStatus VO for the state machine.
  processingStatus String @default("not_started") // not_started | processing | ocr_complete | ocr_failed
  userRetryCount   Int    @default(0) // capped at 3 in the aggregate

  // Phase 8 — clause-extraction lifecycle. Document-level view; the
  // ExtractionRun aggregate owns the detail (model versions, counts).
  extractionStatus       String  @default("not_started") // not_started | extracting | extraction_complete | extraction_failed
  currentExtractionRunId String?

  // Playbook-Driven Contract Review agent. The review runs asynchronously
  // (can exceed the HTTP request window), so its state lives here and the
  // frontend polls for it.
  reviewStatus   String    @default("not_started") // not_started | running | complete | failed
  reviewMarkdown String? // the §4 risk report
  reviewRuntime  String? // anthropic | agentcore — which runtime produced it
  reviewError    String? // failure reason when reviewStatus=failed
  reviewedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  documentText   DocumentText?
  extractionRuns ExtractionRun[]
  clauses        Clause[]
  listItem       DocumentListItem?

  // Every read is scoped by orgId, so the index drives every list query.
  @@index([orgId])
  @@index([uploadedBy])
  @@index([orgId, status])
  @@index([processingStatus])
  @@index([extractionStatus])
}

// -----------------------------------------------------------------------------
// OCR output (Phase 7)
// -----------------------------------------------------------------------------

// One DocumentText per Document. The text + per-page detail lives in
// IStorageService at `{documentId}.text.json`; this row carries the
// metadata needed to query, list, and triage without fetching the blob.
model DocumentText {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  storageKey        String @unique // Opaque '{documentId}.text.json'
  textLength        Int // chars; cheap signal for "did we extract anything"
  confidence        Float // 0..1, char-length-weighted mean across pages
  minPageConfidence Float // 0..1, smallest per-page confidence
  language          String // ISO 639-1, or 'und' if detection bypassed
  driver            String // native_pdf | google_document_ai | mock | hybrid
  pageCount         Int

  extractedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([driver])
}

// -----------------------------------------------------------------------------
// Clause extraction (Phase 8)
// -----------------------------------------------------------------------------

// One run per extraction attempt. Re-extraction creates a new row; old runs
// are retained for audit (`Document.currentExtractionRunId` points at the
// newest). See clause-extraction-design.md §3.1.
model ExtractionRun {
  id         String   @id // UUID, supplied by the application (ExtractionRunId VO)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  classifierModelVersion String // <vendor>/<name>@<version>
  embeddingModelVersion  String

  status             String // running | complete | failed
  failureReason      String?
  clauseCount        Int     @default(0)
  droppedClauseCount Int     @default(0) // hallucinated-text drops

  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // Document-level metadata captured by the same Claude call that
  // produced the clauses. Stored as JSON for Phase 8 (no field-level
  // queries yet). Phase 10+ may promote to columns if filter use cases
  // emerge ("contracts expiring in 60 days", "all NDAs with Acme").
  metadata Json?

  clauses Clause[]

  @@index([documentId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Audit domain (Phase 6)
// -----------------------------------------------------------------------------

// Append-only audit log. No UPDATE or DELETE operations are permitted on this
// table — the repository enforces INSERT + SELECT only. Each row carries a
// SHA-256 checksum for tamper detection.
model AuditEvent {
  id             String   @id
  actorId        String
  action         String
  resourceType   String
  resourceId     String
  checksum       String
  sequenceNumber Int
  timestamp      DateTime
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resourceId])
  @@index([timestamp])
  @@index([sequenceNumber])
}

// -----------------------------------------------------------------------------
// Document list projection (Phase 10) — CQRS read model
// -----------------------------------------------------------------------------
//
// Denormalised, per-document row optimised for the Contracts View (Portfolio)
// screen. Populated by domain event handlers in the documents module — never
// mutated by application code outside those handlers. The Document aggregate
// remains the source of truth; this table is a disposable cache that can be
// rebuilt from scratch via the backfill script.
//
// One row per Document. `id` mirrors Document.id (FK with cascade delete) so
// the row vanishes when the document is hard-deleted.
model DocumentListItem {
  id           String   @id // == Document.id
  orgId        String
  name         String // file name with extension stripped
  type         String // ContractType (vendor | license | partnership | customer | lease | nda | other)
  counterparty String // first party — '' if unknown
  riskScore    Float? // null until extraction completes
  flagsRed     Int      @default(0)
  flagsOrange  Int      @default(0)
  flagsBlue    Int      @default(0)
  terminationDate        DateTime?
  status                 String // complete | processing | failed
  uploadedAt             DateTime
  hasUnlimitedLiability  Boolean  @default(false)
  updatedAt              DateTime @updatedAt

  document Document @relation(fields: [id], references: [id], onDelete: Cascade)

  // Every list query is scoped by orgId then filters/sorts on one of the
  // columns below — the composite indexes drive all four read paths.
  @@index([orgId, riskScore])
  @@index([orgId, uploadedAt])
  @@index([orgId, name])
  @@index([orgId, status])
}

// Position-anchored, classified, embedding-equipped clause. Embedding is
// nullable so a Voyage outage doesn't kill the extraction run — clauses
// land with `embedding = NULL` and a backfill job (deferred) can re-embed.
// Vector column uses pgvector; Prisma can't type it natively so we use
// `Unsupported("vector(1024)")` plus raw SQL for insert/select.
model Clause {
  id              String  @id // UUID (ClauseId VO)
  extractionRunId String
  documentId      String // denormalised for fast doc-scoped queries
  parentClauseId  String? // self-FK, max 2 levels deep, SET NULL on parent delete

  type                  String // ClauseType (15 values)
  confidence            Float
  pageNumber            Int
  startOffset           Int
  endOffset             Int
  text                  String                       @db.Text
  embedding             Unsupported("vector(1024)")?
  embeddingModelVersion String?

  // Phase 8 persists, Phase 8 UI ignores. Phase 9 wires risk into the UI
  // and event flow once the rubric is SME-validated.
  riskScore       Int?
  riskLevel       String? // low | medium | high | critical
  riskFlags       String[] @default([])
  riskExplanation String?  @db.Text

  createdAt DateTime @default(now())

  extractionRun ExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  document      Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent        Clause?       @relation("ClauseHierarchy", fields: [parentClauseId], references: [id], onDelete: SetNull)
  children      Clause[]      @relation("ClauseHierarchy")

  @@index([documentId])
  @@index([extractionRunId])
  @@index([type])
  @@index([parentClauseId])
}

// -----------------------------------------------------------------------------
// Chat domain (Phase 12 — "Ask Your Portfolio")
// -----------------------------------------------------------------------------

// Thread aggregates a conversation session between a user and the AI assistant.
// One row per conversation; a user may have multiple threads.
model ChatThread {
  id     String @id // UUID, supplied by the application (ChatThreadId VO)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String // v1: orgId == userId. Becomes a real Org FK later.

  title  String?
  status String  @default("active") // active | archived | deleted

  // Document IDs in scope when the thread was created (audit + scope limiting).
  portfolioSnapshot Json?
  // Model/settings snapshot at creation, for reproducibility.
  settingsSnapshot  Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  messages ChatMessage[]

  @@index([userId])
  @@index([orgId])
  @@index([status])
  @@index([createdAt])
}

// Position-anchored message in a thread. Immutable once created.
// User and assistant messages share the table; `role` disambiguates.
model ChatMessage {
  id       String     @id // UUID (ChatMessageId VO)
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  role     String // "user" | "assistant"
  content  String @db.Text
  sequence Int // per-thread ordering (1, 2, 3, ...)

  // user msg: original query for audit/replay; assistant msg: producing query.
  querySnapshot   Json?
  // assistant msg: how the question was routed { queryType, clauses, documents }.
  routingAnalysis Json?
  // assistant msg: validated source references.
  citations       Json[] @default([])
  // execution metadata { llmInputTokens, llmOutputTokens, executionTimeMs }.
  executionMetadata Json?

  failureReason String?
  status        String  @default("success") // success | pending | failed

  createdAt DateTime @default(now())

  feedback ChatFeedback?

  @@index([threadId, sequence])
  @@index([role])
  @@index([status])
}

// Thumbs up/down + optional comment on an assistant message. Kept separate so
// the message row stays immutable.
model ChatFeedback {
  id        String      @id // UUID
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  score   Int // -1 = unhelpful, 0 = neutral, 1 = helpful
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
