# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SESSION_SECRET=replace-with-secret-min-32-characters-long

# Database (Prisma) — local dev runs Postgres via docker-compose at
# the repo root (`docker compose up -d`). Railway plugs in DATABASE_URL
# automatically in prod via the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_intel?schema=public

# Encryption (AES-256-CBC + PBKDF2 — used by SessionEncryptionService)
ENCRYPTION_KEY=replace-with-key-min-32-characters-long
ENCRYPTION_KEY_NAME=primary

# Auth0 (Universal Login, Authorization Code Flow)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# Storage (local | gcs) — see docs/deployment/gcp-setup.md for GCS provisioning
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# GCS (only needed when STORAGE_DRIVER=gcs)
# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# Either a base64-encoded service account JSON (for env-var-friendly
# transport, e.g. Railway dashboard) or a filesystem path to the JSON
# key. If unset, falls back to Application Default Credentials (gcloud).
# GCS_SERVICE_ACCOUNT_KEY=

# OCR (mock | google-document-ai)
OCR_DRIVER=mock

# OCR pipeline guards (Phase 7).
# OCR_PAGE_LIMIT — reject documents above this page count (cost ceiling).
# OCR_TEXT_QUALITY_THRESHOLD — pages below this score (0..1) are demoted
#   from native extraction to cloud OCR (catches broken-cmap PDFs).
# OCR_LANGUAGE_CONFIDENCE_THRESHOLD — gap (top vs second franc score)
#   above which we trust a language verdict and reject non-allowlisted.
# OCR_PAGE_LIMIT=200
# OCR_TEXT_QUALITY_THRESHOLD=0.5
# OCR_LANGUAGE_CONFIDENCE_THRESHOLD=0.1

# Document AI (required only when OCR_DRIVER=google-document-ai).
# Provisioned by `./scripts/setup-document-ai.sh` — that script prints
# these values. The service account / GCS bucket are shared with the
# Phase 5 upload feature (see GCS_BUCKET_NAME above).
# OCR_GCP_PROJECT_ID=
# OCR_GCP_LOCATION=eu
# OCR_GCP_PROCESSOR_ID=
# OCR_GCP_BATCH_OUTPUT_PREFIX=gs://your-bucket/ocr

# Clause extraction (Phase 8).
#   CLAUSE_EXTRACTOR: mock | anthropic   (anthropic wired in Task 8.4)
#   EMBEDDING_DRIVER: mock | voyage      (voyage wired in Task 8.5)
# Default `mock` runs the full pipeline locally with no external API.
CLAUSE_EXTRACTOR=mock
EMBEDDING_DRIVER=mock

# AI (required in production)
CLAUDE_API_KEY=

# Queue (memory | pg-boss | bullmq)
QUEUE_DRIVER=memory

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173
