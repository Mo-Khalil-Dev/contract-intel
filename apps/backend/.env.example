# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SESSION_SECRET=replace-with-secret-min-32-characters-long

# Auth0 (required in production)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# Storage (local | gcs)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# OCR (mock | google-document-ai)
OCR_DRIVER=mock

# AI (required in production)
CLAUDE_API_KEY=

# Queue (memory | pg-boss | bullmq)
QUEUE_DRIVER=memory

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173
