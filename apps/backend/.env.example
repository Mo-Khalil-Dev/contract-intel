# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SESSION_SECRET=replace-with-secret-min-32-characters-long

# Database (Prisma)
DATABASE_URL=file:./dev.db

# Encryption (AES-256-CBC + PBKDF2 — used by SessionEncryptionService)
ENCRYPTION_KEY=replace-with-key-min-32-characters-long
ENCRYPTION_KEY_NAME=primary

# Auth0 (Universal Login, Authorization Code Flow)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:3000/api/v1/auth/callback

# Frontend
FRONTEND_URL=http://localhost:5173

# Storage (local | gcs) — see docs/deployment/gcp-setup.md for GCS provisioning
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# GCS (only needed when STORAGE_DRIVER=gcs)
# GCS_PROJECT_ID=
# GCS_BUCKET_NAME=
# Either a base64-encoded service account JSON (for env-var-friendly
# transport, e.g. Railway dashboard) or a filesystem path to the JSON
# key. If unset, falls back to Application Default Credentials (gcloud).
# GCS_SERVICE_ACCOUNT_KEY=

# OCR (mock | google-document-ai)
OCR_DRIVER=mock

# AI (required in production)
CLAUDE_API_KEY=

# Queue (memory | pg-boss | bullmq)
QUEUE_DRIVER=memory

# Logging (trace | debug | info | warn | error | fatal)
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173
